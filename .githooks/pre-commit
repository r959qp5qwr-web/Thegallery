#!/bin/sh
# The Gallery — fail-closed consequence gate before a commit (Builders' Playbook §3).
#
# Amended 2026-09-04 by Governor enforcement-closure instruction. The first version of this
# file exited 0 ("fail open") when python3 was unavailable, which turned a broken toolchain
# into permission to commit. This layer exists precisely because the harness hook layer
# cannot be trusted to run, so it fails CLOSED: if the gate cannot establish that the commit
# is allowed, the commit does not happen. A human who must commit anyway still has
# `git commit --no-verify`, which is a deliberate, visible act; that residue is what the CI
# job at the pull-request chokepoint is for (doctrine/EXTERNAL_ENABLEMENT.md).
set -u
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "doctrine gate: cannot find the repository root — commit refused." >&2; exit 1; }
BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  if [ "${DOCTRINE_ALLOW_MAIN:-}" != "1" ]; then
    echo "doctrine gate: direct commit on '$BRANCH' refused (Canon Day Zero #6). Work on a branch; DOCTRINE_ALLOW_MAIN=1 only under an explicit Governor instruction." >&2
    exit 1
  fi
fi
if ! command -v python3 >/dev/null 2>&1; then
  echo "doctrine gate: python3 is unavailable, so orientation cannot be verified — commit refused." >&2
  echo "  This gate fails closed by Governor instruction 2026-09-04: an unverifiable state is not permission." >&2
  exit 1
fi
if ! python3 -B "$ROOT/scripts/doctrine-orient.py" check --quiet; then
  echo "doctrine gate: orientation invalid — commit refused. Run: python3 scripts/doctrine-orient.py orient" >&2
  exit 1
fi
if ! python3 -B "$ROOT/scripts/doctrine-gate.py" --quiet; then
  echo "doctrine gate: repository gates failed — commit refused. Run: python3 scripts/doctrine-gate.py" >&2
  exit 1
fi
exit 0
