#!/bin/sh
# The Gallery — fail-closed consequence gate before a push (Builders' Playbook §3), plus the
# product's own read-only rule: nothing is ever pushed to builders-doctrine from here.
# Amended 2026-09-04: fails closed when the gate cannot run (was: exit 0).
set -u
REMOTE_URL="${2:-}"
case "$REMOTE_URL" in
  *builders-doctrine*)
    echo "doctrine gate: push to builders-doctrine refused — the central Doctrine is read-only from this product (Commission v1.1 §3)." >&2
    exit 1 ;;
esac
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "doctrine gate: cannot find the repository root — push refused." >&2; exit 1; }
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  case "$REMOTE_REF" in
    refs/heads/main|refs/heads/master)
      if [ "${DOCTRINE_ALLOW_MAIN:-}" != "1" ]; then
        echo "doctrine gate: push to '$REMOTE_REF' refused (Canon Day Zero #6). The default branch is reached through review." >&2
        exit 1
      fi ;;
  esac
done
if ! command -v python3 >/dev/null 2>&1; then
  echo "doctrine gate: python3 is unavailable, so orientation cannot be verified — push refused." >&2
  exit 1
fi
if ! python3 -B "$ROOT/scripts/doctrine-orient.py" check --quiet; then
  echo "doctrine gate: orientation invalid — push refused. Run: python3 scripts/doctrine-orient.py orient" >&2
  exit 1
fi
if ! python3 -B "$ROOT/scripts/doctrine-gate.py" --quiet; then
  echo "doctrine gate: repository gates failed — push refused. Run: python3 scripts/doctrine-gate.py" >&2
  exit 1
fi
exit 0
