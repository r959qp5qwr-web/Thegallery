#!/bin/sh
# The Gallery — downstream consequence gate before push (Builders' Playbook §3), plus the
# product's own read-only rule: nothing is ever pushed to builders-doctrine from here.
REMOTE_NAME="$1"; REMOTE_URL="$2"
case "$REMOTE_URL" in
  *builders-doctrine*) echo "doctrine gate: push to builders-doctrine refused — the central Doctrine is read-only from this product (Commission v1.1 §3)." >&2; exit 1 ;;
esac
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
if ! command -v python3 >/dev/null 2>&1; then
  echo "doctrine gate: python3 unavailable — FAIL-OPEN (Governor ruling 2026-08-09)." >&2
  exit 0
fi
if ! python3 -B "$ROOT/scripts/doctrine-orient.py" check --quiet; then
  echo "doctrine gate: orientation invalid — push refused. Run: python3 scripts/doctrine-orient.py orient" >&2
  exit 1
fi
exit 0
