# The Gallery — environment contract (Stage 2, Supabase-native per GAL-SUPA-1).
# Copy to .env.local. Nothing here is a production credential.
#
# There is no DATABASE_URL for the application any more, and no service-role key anywhere.
# The app is an ordinary Supabase client: PostgREST holds the connection and switches into
# `anon` or `authenticated` according to the token, and the policies in db/migrations decide
# the rest. A key that bypasses row-level security, held by the thing serving public requests,
# would make every one of those policies advisory.

SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable key. It is meant to reach a browser; it is not a secret.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_STORAGE_BUCKET=gallery-images

# One product, one schema. Never `public`: this database may belong to another product too.
GALLERY_SCHEMA=gallery

# Base URL used in confirmation and recovery links.
GALLERY_BASE_URL=http://127.0.0.1:3100

# --- local only, and not used by the application ------------------------------------------
# The migration runner, the seed and the policy probes talk to a local cluster directly,
# because this environment cannot run Supabase (no usable Docker daemon). They are the only
# things that use these, and they are the reason `pg` is still a dependency.
DATABASE_URL_OWNER=postgres://postgres@127.0.0.1:5432/gallery
DATABASE_URL_ADMIN=postgres://postgres@127.0.0.1:5432/postgres
DATABASE_URL_AUTHENTICATOR=postgres://authenticator:local_dev_only@127.0.0.1:5432/gallery

PLAYWRIGHT_CHROMIUM=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
