# The Gallery — environment contract.
# Copy to .env.local for local work. NO PRODUCTION CREDENTIAL BELONGS IN THIS FILE OR IN GIT:
# the values below are local defaults and placeholders.

# ---------------------------------------------------------------- schema (co-tenancy)
# This product owns exactly ONE schema and never `public`, so the database may be shared with
# another product without a name clash. Changing this changes where everything lives.
GALLERY_SCHEMA=gallery

# ---------------------------------------------------------------- database
# The application connects as a role with NO privileges of its own, which may only SET ROLE to
# gallery_anon or gallery_auth. Row-level security applies because of that. Never point the
# application at the owner connection.
DATABASE_URL_APP=postgres://gallery_app:gallery_local_dev@127.0.0.1:5432/gallery
DATABASE_URL_OWNER=postgres://postgres@127.0.0.1:5432/gallery
DATABASE_URL_ADMIN=postgres://postgres@127.0.0.1:5432/postgres

# Supabase: use the SESSION-mode pooler (port 5432 on aws-N-<region>.pooler.supabase.com), not
# transaction mode. This application sets search_path on a pooled connection outside a
# transaction, which transaction pooling does not carry between statements. See db/SUPABASE.md.
# DATABASE_URL_APP=postgres://gallery_app.<project-ref>:<password>@aws-N-<region>.pooler.supabase.com:5432/postgres
# DATABASE_URL_OWNER=postgres://postgres.<project-ref>:<password>@aws-N-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------- storage
# Uploaded originals and derived variants. Outside the served tree on purpose: pixels are
# reached through /img/[id]/[variant], which re-checks public visibility.
GALLERY_STORAGE_DIR=./var/storage

# ---------------------------------------------------------------- URLs
GALLERY_BASE_URL=http://127.0.0.1:3100
# Production: https://atthegallery.in

# ---------------------------------------------------------------- mail
# outbox — record the message and SEND NOTHING (local default; not an email round trip).
# resend — record, then send through Resend. IMPLEMENTED, NOT TESTED: no sender credential
#          exists in the build environment, so the first real deployment is what proves it.
GALLERY_MAIL=outbox
# GALLERY_MAIL=resend
# RESEND_API_KEY=
# GALLERY_MAIL_FROM=The Gallery <hello@atthegallery.in>

# ---------------------------------------------------------------- tests
PLAYWRIGHT_CHROMIUM=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# ---------------------------------------------------------------- NOT USED
# This build talks to Postgres directly with its own roles and its own session auth, which is
# what makes the permission probes real. It uses no Supabase client library, so the project's
# publishable/anon key is not read anywhere. Recorded here so nobody wires it in by reflex.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<unused by this build>
