# The Gallery — environment contract (Stage 2, local proof).
# Copy to .env.local. Every value here is a LOCAL development value; none of it is a
# production credential, and no production credential belongs in this repository.

# The application connects as gallery_app, a non-superuser role that may only SET ROLE to
# gallery_anon or gallery_auth. Row-level security applies because of this. Do not point the
# application at the owner connection.
DATABASE_URL_APP=postgres://gallery_app:gallery_local_dev@127.0.0.1:5432/gallery
DATABASE_URL_OWNER=postgres://postgres@127.0.0.1:5432/gallery
DATABASE_URL_ADMIN=postgres://postgres@127.0.0.1:5432/postgres

# Where uploaded originals and derived variants are written. Outside the served tree on
# purpose: pixels are reached through /img/[id]/[variant], which re-checks public visibility.
GALLERY_STORAGE_DIR=./var/storage

# Base URL used in confirmation and recovery links.
GALLERY_BASE_URL=http://127.0.0.1:3100

# Local mail: 'outbox' writes to the dev_outbox table and sends nothing. There is no
# transactional sender in this environment, so no session may claim an email round trip.
GALLERY_MAIL=outbox
PLAYWRIGHT_CHROMIUM=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
