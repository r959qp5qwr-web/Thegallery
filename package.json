{
  "name": "thegallery",
  "version": "0.2.0",
  "private": true,
  "description": "The Gallery — maker-led digital gallery. Stage 2 vertical slice.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "db:reset": "node --experimental-strip-types db/cli.ts reset",
    "db:migrate": "node --experimental-strip-types db/cli.ts migrate",
    "db:seed": "node --experimental-strip-types db/seed.ts",
    "test:policy": "node --experimental-strip-types tests/policy/run.ts",
    "test:e2e": "playwright test",
    "db:sqlfile": "node --experimental-strip-types db/sqlfile.ts",
    "build:wasm": "node src/lib/wasm/embed.mjs"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/resize": "^2.1.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "next": "16.3.4",
    "pg": "8.16.3",
    "pg-cloudflare": "1.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "sharp": "0.34.4",
    "typescript": "5.9.3",
    "wrangler": "^4.129.0"
  }
}
